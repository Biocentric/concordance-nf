/*
 * somalier sites files, per assembly.
 *
 * These are release assets on brentp/somalier. Nextflow will fetch a remote
 * URL straight into the work dir, so no manual staging is needed; point
 * --sites at a local copy for air-gapped runs.
 *
 * The chr/nochr distinction is the single most common way to get a silently
 * empty result: sites.hg38.vcf.gz uses UCSC-style `chr1`, GRCh38_nochr uses
 * Ensembl-style `1`. A mismatch against your reference yields zero usable
 * sites rather than an error, so the report checks the per-sample site count
 * and fails loudly (see params.min_sites).
 */

params {
    genomes {
        'GRCh38' {
            sites        = 'https://github.com/brentp/somalier/files/3412456/sites.hg38.vcf.gz'
            contig_style = 'chr'
        }
        'GRCh38_nochr' {
            sites        = 'https://github.com/brentp/somalier/files/3412454/sites.hg38.nochr.vcf.gz'
            contig_style = 'nochr'
        }
        'GRCh37' {
            sites        = 'https://github.com/brentp/somalier/files/3412455/sites.GRCh37.vcf.gz'
            contig_style = 'nochr'
        }
        'hg19' {
            sites        = 'https://github.com/brentp/somalier/files/3412453/sites.hg19.vcf.gz'
            contig_style = 'chr'
        }
        'CHM13' {
            // T2T sites contributed by @kpalin. Sketches extracted against these
            // are comparable with GRCh37/GRCh38 sketches (somalier >= 0.2.16).
            sites        = 'https://github.com/brentp/somalier/files/9954286/sites.chm13v2.T2T.vcf.gz'
            contig_style = 'chr'
        }
        'GRCh38_rna' {
            // Restricted to sites likely to be expressed in GTEx; use when
            // cross-checking RNA-seq against DNA. DIFFERENT coordinates from the
            // GRCh38 set - never mix sketches across the two.
            sites        = 'https://github.com/brentp/somalier/files/4566475/sites.hg38.rna.vcf.gz'
            contig_style = 'chr'
        }
    }
}
