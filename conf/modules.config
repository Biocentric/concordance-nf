/*
 * Per-process directives.
 *
 * The somalier container override is the important part here: the nf-core
 * modules pin 0.2.19 and we need >= 0.3.5. See params.somalier_* in
 * nextflow.config for why.
 */

process {

    publishDir = [
        path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:    params.publish_dir_mode,
        saveAs:  { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ---- somalier version override --------------------------------------
    withName: 'SOMALIER_EXTRACT|SOMALIER_RELATE|SOMALIER_ANCESTRY|SOMALIER_CONTAMINATION' {
        conda     = "bioconda::somalier=${params.somalier_version}"
        container = { workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container
            ? params.somalier_singularity
            : params.somalier_container }
    }

    withName: 'SOMALIER_EXTRACT' {
        publishDir = [
            path:    { "${params.outdir}/sketches" },
            mode:    params.publish_dir_mode,
            enabled: params.publish_sketches,
            pattern: '*.somalier'
        ]
    }

    withName: 'SOMALIER_RELATE' {
        // --infer makes somalier write an inferred sex into the `sex` column of
        // samples.tsv while preserving whatever was supplied in
        // original_pedigree_sex. The report uses that for the sex check and
        // falls back to computing X-het / Y-depth itself if it looks unset.
        ext.args   = '--infer'
        ext.prefix = 'somalier'
        publishDir = [
            path:   { "${params.outdir}/somalier" },
            mode:   params.publish_dir_mode,
            pattern: '*.{html,tsv,ped}'
        ]
    }

    withName: 'SOMALIER_CONTAMINATION' {
        // distinct prefix: `somalier contamination -o X` writes X.samples.tsv
        // and X.pairs.tsv, which would otherwise collide with relate's output
        ext.prefix = 'somalier.contamination'
        ext.args   = { "--min-depth ${params.min_depth as int}" }
        publishDir = [
            path:    { "${params.outdir}/somalier" },
            mode:    params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'SOMALIER_ANCESTRY' {
        publishDir = [
            path:    { "${params.outdir}/somalier" },
            mode:    params.publish_dir_mode,
            pattern: '*.{tsv,html}'
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        // indexes generated on the fly are scratch, not a deliverable
        publishDir = [ enabled: false ]
    }

    withName: 'HTSLIB_BGZIPTABIX' {
        // The output name MUST differ from the input name. bgziptabix builds
        // its output as <ext.prefix>.vcf.gz, so a plain gzip-compressed input
        // already called <sample>.vcf.gz (very common) would otherwise collide
        // and the module aborts with "Input and output names cannot be the
        // same". somalier names the sketch from the VCF sample column, not the
        // filename, so the suffix never reaches the results.
        ext.prefix = { "${meta.id}.prepared" }
        publishDir = [ enabled: false ]
    }

    withName: 'CONCORDANCE_REPORT' {
        conda     = 'conda-forge::python=3.12'
        container = { workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container
            ? params.python_singularity
            : params.python_container }
        publishDir = [
            path:    { "${params.outdir}/concordance" },
            mode:    params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path:    { "${params.outdir}/multiqc" },
            mode:    params.publish_dir_mode
        ]
    }
}
