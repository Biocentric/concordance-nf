/*
 * Wiring-only smoke test. Exercises the input paths the real test profile does
 * not - CRAM with an index, CRAM without one, BAM without one, and a VCF - so
 * SAMTOOLS_INDEX and HTSLIB_BGZIPTABIX both get hit. The alignment files are
 * empty placeholders, so this profile is only meaningful with -stub:
 *
 *     nextflow run . -profile test_stub,docker -stub --outdir results-stub
 */

params {
    config_profile_name        = 'Stub test profile'
    config_profile_description = 'Mixed BAM/CRAM/VCF inputs, -stub only'

    input  = "${projectDir}/assets/test_stub_samplesheet.csv"
    fasta  = "${projectDir}/assets/test/tiny.fasta"
    fai    = "${projectDir}/assets/test/tiny.fasta.fai"
    sites  = "${projectDir}/assets/test/tiny.sites.vcf.gz"

    min_sites         = 1
    min_depth         = 0
    run_contamination = true
    skip_multiqc      = false
}

process {
    resourceLimits = [ cpus: 2, memory: '4.GB', time: '1.h' ]
}
