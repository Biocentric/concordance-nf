/*
 * Minimal *real* test: runs the whole pipeline, real somalier, in seconds.
 *
 *     nextflow run . -profile test,docker --outdir results-test
 *
 * assets/test_data/ is a synthetic 7-sample cohort with a known identity
 * structure (tests/make_fixture_vcfs.py builds it):
 *
 *     s_a / s_b   same subject, same genotypes       -> CONFIRMED_MATCH
 *     s_c / s_e   different subjects, same genotypes -> UNEXPECTED_DUPLICATE
 *     s_f / s_g   same subject, different genotypes  -> SAMPLE_SWAP
 *     18 other pairs                                 -> CONFIRMED_DISTINCT
 *
 * tests/run_e2e.sh runs this and asserts every verdict.
 */

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic 7-sample cohort with a known identity structure'

    input  = "${projectDir}/assets/test_data/samplesheet.csv"
    fasta  = "${projectDir}/assets/test_data/ref.fasta"
    fai    = "${projectDir}/assets/test_data/ref.fasta.fai"
    sites  = "${projectDir}/assets/test_data/sites.vcf.gz"

    // the fixture panel is 4000 sites on one contig, so the production
    // defaults would flag every sample as underpowered
    min_sites         = 500
    min_depth         = 5

    run_contamination = true
    run_ancestry      = false
    skip_multiqc      = false
}

process {
    resourceLimits = [ cpus: 2, memory: '6.GB', time: '1.h' ]
}
