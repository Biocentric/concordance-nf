/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Biocentric/concordance-nf - Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SNP concordance / sample-identity QC for WGS. somalier sketches over
    BAM/CRAM/VCF, all-vs-all relate, expectation-aware verdicts.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // ---- input / output -------------------------------------------------
    input                         = null       // samplesheet CSV
    outdir                        = './results'
    publish_dir_mode              = 'copy'

    // ---- reference ------------------------------------------------------
    genome                        = 'GRCh38'   // key into conf/genomes.config
    fasta                         = null       // required for CRAM; strongly advised for BAM
    fai                           = null       // defaults to ${fasta}.fai
    sites                         = null       // overrides the per-genome default

    // ---- sketch registry ------------------------------------------------
    // Directory of previously extracted *.somalier sketches. Mixed into the
    // all-vs-all so every new sample is checked against project history, not
    // just against its own batch. This is the whole point of the sketch.
    registry                      = null
    publish_sketches              = true

    // ---- optional somalier inputs ---------------------------------------
    ped                           = null       // PED for pedigree-aware relate
    sample_groups                 = null       // somalier -g groups file

    // ---- analysis toggles -----------------------------------------------
    run_contamination             = true       // somalier contamination (>=0.3.2)
    run_ancestry                  = false
    ancestry_labels               = null       // labels TSV for somalier ancestry
    ancestry_labelled_dir         = null       // dir of labelled *.somalier
    skip_multiqc                  = false

    // ---- concordance decision thresholds --------------------------------
    // Pair is called IDENTICAL when relatedness >= identity_min_relatedness
    // AND the IBS0 rate is at or below identity_max_ibs0_rate. IBS0 (one
    // sample hom-ref, the other hom-alt) is genetically impossible within an
    // individual, so it is what separates self from parent-child, and it
    // survives tumour LOH where het-based concordance does not.
    min_sites                     = 1000
    min_depth                     = 5.0
    identity_min_relatedness      = 0.85
    identity_max_ibs0_rate        = 0.005
    first_degree_min_relatedness  = 0.35
    second_degree_min_relatedness = 0.15
    contamination_warn            = 0.02
    contamination_fail            = 0.05
    fail_on_discordance           = false      // exit non-zero on any FAIL

    // ---- tool versions --------------------------------------------------
    // nf-core's somalier modules pin 0.2.19, which predates the whole 0.3.x
    // line: no CHARR contamination, no pairwise contamination subcommand, a
    // long-read allele-counting bug (fixed 0.3.4) and wrong hom-ref/hom-alt
    // counts (fixed 0.3.5). conf/modules.config overrides the container.
    somalier_version              = '0.3.5'
    somalier_container            = 'quay.io/biocontainers/somalier:0.3.5--h5205c93_0'
    somalier_singularity          = 'https://depot.galaxyproject.org/singularity/somalier:0.3.5--h5205c93_0'
    python_container              = 'quay.io/biocontainers/python:3.12'
    python_singularity            = 'https://depot.galaxyproject.org/singularity/python:3.12'

    // ---- boilerplate ----------------------------------------------------
    help                          = false
    version                       = false
    monochrome_logs               = false
}

includeConfig 'conf/genomes.config'
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug       { process.beforeScript = 'echo $HOSTNAME' }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        conda.enabled        = false
    }
    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
    }
    test        { includeConfig 'conf/test.config' }
    test_stub   { includeConfig 'conf/test_stub.config' }
}

// Report which Nextflow-managed outputs were produced
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }

manifest {
    name            = 'Biocentric/concordance-nf'
    author          = 'Biocentric'
    homePage        = 'https://github.com/Biocentric/concordance-nf'
    description     = 'SNP concordance and sample-identity QC for WGS/WES/targeted data using somalier'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0'
}
